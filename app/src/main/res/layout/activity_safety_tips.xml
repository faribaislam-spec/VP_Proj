<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_gradient">

    <!-- ===== Header ===== -->
    <FrameLayout
        android:id="@+id/headerFrame"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:background="@drawable/bg_header_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- scattered sparkle accents -->
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="90dp"
            android:layout_marginTop="18dp"
            android:alpha="0.85"
            android:src="@drawable/ic_sparkle_star"
            app:tint="@color/sparkle_white"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="40dp"
            android:alpha="0.8"
            android:src="@drawable/ic_sparkle_star"
            app:tint="@color/sparkle_pink"
            android:contentDescription="@null" />

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_menu_circle"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textAllCaps="false"
            android:textColor="@color/lavender_deep"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Safety Tips"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- ===== Filter card ===== -->
    <LinearLayout
        android:id="@+id/filterCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_white"
        android:padding="16dp"
        android:elevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/headerFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Category Filter -->
        <LinearLayout
            android:id="@+id/categoryLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_rgr_tune"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="15sp"
                android:textColor="@color/plum_text"
                android:textStyle="bold"
                android:layout_marginEnd="10dp"/>

            <Spinner
                android:id="@+id/spinnerFilterCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_divider" />

        <!-- Day Night Filter -->
        <LinearLayout
            android:id="@+id/timeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_toggle_row"
            android:padding="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_rgr_sun"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Day"
                android:textSize="14sp"
                android:textColor="@color/plum_text"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:thumbTint="@color/lavender_primary"
                app:trackTint="@color/lavender_light"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Night"
                android:textSize="14sp"
                android:textColor="@color/plum_text"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_rgr_moon"
                android:contentDescription="@null" />

        </LinearLayout>

    </LinearLayout>

    <!-- My Tips button -->
    <Button
        android:id="@+id/btnMyTips"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_mytips"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:elevation="2dp"
        android:stateListAnimator="@null"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="My Tips"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/filterCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Safety Tips List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSafetyTips"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:clipToPadding="false"
        android:focusable="true"
        android:overScrollMode="always"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="80dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMyTips"
        app:layout_constraintVertical_bias="1.0" />

    <!-- Add Tip Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="#FFFFFF"
        app:backgroundTint="@color/lavender_primary"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>