<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_feature_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/reportTypeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Poor Lighting"
            android:textColor="@color/plum_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nightBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tagline_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Night"
            android:textColor="@color/lavender_deep"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/roadNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Mirpur Road, near IUT Gate"
        android:textColor="@color/muted_grey"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/timeAgoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="2 hours ago"
        android:textColor="@color/muted_grey"
        android:textSize="12sp" />

</LinearLayout>