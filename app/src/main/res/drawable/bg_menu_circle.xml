<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/card_shadow" />
        </shape>
    </item>
    <!-- translucent pink circle -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/card_pink_tint" />
            <stroke
                android:width="2dp"
                android:color="@color/card_pink_border" />
        </shape>
    </item>
</layer-list>