<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/card_shadow" />
        </shape>
    </item>
    <!-- glossy red circle -->
    <item
        android:top="6dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="100dp"
                android:centerColor="@color/sos_red_light"
                android:endColor="@color/sos_red_dark" />
            <stroke
                android:width="4dp"
                android:color="@color/sparkle_white" />
        </shape>
    </item>
</layer-list>